{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "project": {
    "name": "nombre-del-proyecto",
    "description": "Descripción del sistema o producto",
    "organization": "Nombre de la Empresa o Cliente"
  },
  "stack": {
    "frontend": "Angular | React | Next.js | Vue | Svelte",
    "ui_libraries": ["PrimeNG | PrimeReact | shadcn/ui | MUI | Angular Material | Ant Design | Vuetify"],
    "css_framework": "Tailwind CSS | SCSS | CSS",
    "backend": "Django | Express | NestJS | FastAPI",
    "databases": ["PostgreSQL | MySQL | SQLite | MongoDB | Redis"],
    "orms": ["Prisma | Drizzle ORM | Django ORM | TypeORM | SQLAlchemy"],
    "package_managers": ["pnpm | npm | yarn | bun | uv"]
  },
  "cloud": {
    "provider": "gcp",
    "project_id": "mi-proyecto-cloud",
    "region": "southamerica-west1",
    "services": {
      "backend": "mi-backend-staging",
      "frontend": "mi-frontend-staging",
      "migration_job": "mi-backend-migrate",
      "database_instance": "mi-sql-instance"
    },
    "urls": {
      "backend_staging": "https://api-staging.ejemplo.com",
      "frontend_staging": "https://staging.ejemplo.com"
    }
  },
  "team": {
    "members": [
      {
        "name": "DESARROLLADOR_1",
        "emails": ["usuario@empresa.com", "dev@gmail.com"]
      }
    ]
  },
  "paths": {
    "backend_dir": "BACKEND",
    "frontend_dir": "frontend",
    "docs_dir": "docs/arquitectura",
    "manuals_dir": "docs/manuales"
  },
  "design": {
    "tokens_file": "docs/diseno/design-tokens.json",
    "generated_css": "docs/diseno/design-tokens.generated.css",
    "docs_md": "docs/diseno/DESIGN_TOKENS.md",
    "landing_dir": ".claude/landing-design",
    "landing_scope": ".claude/landing-design/scope.json",
    "landing_tokens": ".claude/landing-design/TOKENS.json",
    "landing_evidence": ".claude/landing-design/evidence",
    "detected_css_files": []
  },
  "routes": {
    "map_file": "docs/arquitectura/routes-map.json",
    "catalog_md": "docs/arquitectura/CATALOGO_RUTAS.md",
    "plan_maestro": "docs/planeacion/plan-maestro.md"
  },
  "seo": {
    "dir": "docs/seo",
    "config_file": "docs/seo/seo-config.json",
    "report_md": "docs/seo/SEO_REPORT.md"
  },
  "optimization": {
    "dir": "docs/optimizacion",
    "preset": "balanced"
  }
}
