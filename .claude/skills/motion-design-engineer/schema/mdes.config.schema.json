{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Eduardo-Sebastian-Paipay-Vega/developer-autopilot-skills/motion-design-engineer/schema/mdes.config.schema.json",
  "title": "MDES Animation Configuration",
  "description": "Contrato común de configuración para todo recurso del Motion Design Engineering System. Especificación interna del sistema (no es un estándar web).",
  "type": "object",
  "required": ["id", "name", "category", "complexity", "renderer", "canvas", "visual", "motion", "behavior", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Identificador único kebab-case." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": { "enum": ["loading", "success", "error", "empty", "object", "scene", "feedback", "decorative"] },
    "pattern": { "type": "string", "description": "Patrón del catálogo del que deriva (references/pattern-catalog.md)." },
    "complexity": { "enum": ["M1", "M2", "M3", "M4"] },
    "justification": { "type": "string", "description": "Obligatoria para M4 (validada por validateConfig)." },
    "renderer": { "enum": ["css", "svg-css", "svg-css-waapi", "canvas-2d", "webgl-three"] },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "viewBox"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "viewBox": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?( -?\\d+(\\.\\d+)?){3}$" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["primaryColor"],
      "additionalProperties": false,
      "properties": {
        "primaryColor": { "$ref": "#/definitions/color" },
        "secondaryColor": { "$ref": "#/definitions/color" },
        "accentColor": { "$ref": "#/definitions/color" },
        "dangerColor": { "$ref": "#/definitions/color" },
        "backgroundColor": { "$ref": "#/definitions/color" },
        "surfaceColor": { "$ref": "#/definitions/color" },
        "strokeColor": { "$ref": "#/definitions/color" },
        "shadowColor": { "$ref": "#/definitions/color" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "theme": { "enum": ["light", "dark", "brand"] },
        "density": { "type": "integer", "minimum": 1, "description": "Cantidad de elementos repetidos (partículas, puntos, páginas)." },
        "shadow": { "type": "boolean" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["duration"],
      "additionalProperties": false,
      "properties": {
        "duration": { "type": "number", "minimum": 50, "maximum": 20000, "description": "ms del ciclo principal." },
        "speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 4, "description": "Multiplicador aplicado vía playbackRate." },
        "delay": { "type": "number", "minimum": 0 },
        "easing": { "type": "string", "description": "Nombre de token (standard, enter, exit, emphasized, anticipate, loop) o función CSS." },
        "loop": { "oneOf": [{ "type": "boolean" }, { "type": "integer", "minimum": 1 }] },
        "direction": { "enum": ["normal", "reverse", "alternate", "alternate-reverse"] },
        "stagger": { "type": "number", "minimum": 0, "description": "ms entre elementos secuenciales." },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "amplitude": { "type": "number", "minimum": 0 },
        "distance": { "type": "number", "minimum": 0 },
        "overshoot": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "behavior": {
      "type": "object",
      "required": ["reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "enum": ["automatic", "hover", "click", "visible", "state", "manual"] },
        "initialState": { "enum": ["idle", "processing", "success", "error", "paused"] },
        "states": { "type": "array", "items": { "enum": ["idle", "processing", "success", "error", "paused"] }, "uniqueItems": true },
        "progressMode": { "enum": ["indeterminate", "determinate"] },
        "reducedMotion": { "enum": ["static", "minimal", "off"] },
        "pauseWhenHidden": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["decorative"],
      "additionalProperties": false,
      "properties": {
        "decorative": { "type": "boolean" },
        "ariaLabel": { "type": "string" },
        "stateLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle": { "type": "string" },
            "processing": { "type": "string" },
            "success": { "type": "string" },
            "error": { "type": "string" },
            "paused": { "type": "string" }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality": { "enum": ["low", "medium", "high"] },
        "maxAnimatedNodes": { "type": "integer", "minimum": 1 },
        "complexityBudget": { "type": "string" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "svg": { "type": "boolean" },
        "css": { "type": "boolean" },
        "html": { "type": "boolean" },
        "javascript": { "type": "boolean" },
        "adapters": { "type": "array", "items": { "enum": ["angular", "react", "nextjs", "vue", "vanilla", "web-component"] }, "uniqueItems": true }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|transparent|currentColor|rgba?\\(.+\\)|hsla?\\(.+\\)|var\\(--[\\w-]+\\))$"
    }
  }
}
